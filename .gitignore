# ==============================================================================
# OffGridUSB (offgridusb.com) — Git Ignore Configuration
# Tracks the air-gapped runtime app, launchers, manifests, folder guides & docs.
# ==============================================================================

# ------------------------------------------------------------------------------
# Agent Scratchpads, Build Trackers & Working Notes
# ------------------------------------------------------------------------------
.agents/
.gemini/
.claude/
.cursor/
scratch/
notes/
*.scratch*
PROJECT.md
ORIGINAL_REQUEST.md
TEST_INFRA.md
TEST_READY.md
PITCH_CHEATSHEET.md

# ------------------------------------------------------------------------------
# Build Artifacts & Local Test Caches
# (Note: scripts/, docs/, and root .bat/.sh/.command USB tools ARE tracked!)
# ------------------------------------------------------------------------------
# source unit tests ARE tracked (swarm/harness tests)
tests/*
!tests/*.py
pytest.ini
tmp_dl/
build/
dist/
*.egg-info/

# ------------------------------------------------------------------------------
# Portable Runtime Binaries & Offline Knowledge / Model Packs
# Keep directory skeletons + README.md guides tracked in Git, ignore payloads!
# ------------------------------------------------------------------------------
bin/*
!bin/README.md
!bin/windows_x86_64/
bin/windows_x86_64/*
!bin/windows_x86_64/README.md
!bin/windows_arm64/
bin/windows_arm64/*
!bin/windows_arm64/README.md
!bin/linux_x86_64/
bin/linux_x86_64/*
!bin/linux_x86_64/README.md
!bin/linux_arm64/
bin/linux_arm64/*
!bin/linux_arm64/README.md
!bin/macos_arm64/
bin/macos_arm64/*
!bin/macos_arm64/README.md
!bin/macos_x86_64/
bin/macos_x86_64/*
!bin/macos_x86_64/README.md
!bin/polyglot/
bin/polyglot/*
!bin/polyglot/README.md

data/*
!data/README.md
!data/zim/
data/zim/*
!data/zim/README.md
!data/models/
data/models/*
!data/models/README.md
!data/vault/
data/vault/*
!data/vault/README.md
!data/uploads/
data/uploads/*
!data/uploads/README.md

*.gguf
*.zim
*.safetensors
*.onnx
*.tar.gz
*.zip
*.exe
*.dll
*.so
*.so.*
*.dylib
*.pyd

# ------------------------------------------------------------------------------
# Runtime SQLite Vaults, Logs & Process Files
# ------------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
*.pid

# ------------------------------------------------------------------------------
# Python Bytecode, Caches & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/
env/

# ------------------------------------------------------------------------------
# Secrets, OS Metadata & OneDrive Sync Conflict Copies
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
Desktop.ini
*-DESKTOP-*
*-JoeWorkTop*
